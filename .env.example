# PostgreSQL. These configure the server, and the app derives its connection URL from
# them, so the credentials are written once. POSTGRES_HOST defaults to the compose
# service name; set DATABASE_URL_OVERRIDE for anything these parts can't express.
POSTGRES_USER=geotriage
POSTGRES_PASSWORD=geotriage
POSTGRES_DB=geotriage

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=artifacts

# How many jobs one worker container claims at a time.
WORKER_CONCURRENCY=4

# Absolute host path the docker daemon can bind-mount from when running an image.
# `docker run -v` sources are resolved on the host, not inside the container that asked.
RUN_SCRATCH_HOST=/abs/path/to/geotriage/.run-scratch
