{
  "models": [
    {
      "descriptor_version": 1,
      "kind": "model",
      "slug": "ndwi-water-detector",
      "name": "NDWI Water Body Detector",
      "description": "Computes the Normalized Difference Water Index (NDWI = (Green \u2212 NIR) / (Green + NIR)) to detect surface water extent and flag changes relative to configured thresholds.",
      "requires": {
        "bands": [
          "green",
          "nir"
        ],
        "max_cloud_cover": 30.0,
        "gsd_m": null,
        "cost": "medium"
      },
      "prefilter": null,
      "scores": {
        "ndwi_mean": {
          "description": "Mean NDWI across all valid pixels in the AOI",
          "unit": "index",
          "range": [
            -1.0,
            1.0
          ],
          "primary": true,
          "thresholds": {
            "green": [
              0.3,
              1.0
            ],
            "yellow": [
              0.0,
              0.3
            ]
          }
        },
        "water_fraction": {
          "description": "Fraction of valid pixels classified as water (NDWI > 0.3)",
          "unit": "fraction",
          "range": [
            0.0,
            1.0
          ],
          "primary": false,
          "thresholds": {
            "green": [
              0.5,
              1.0
            ],
            "yellow": [
              0.2,
              0.5
            ]
          }
        }
      },
      "rasters": [
        "ndwi"
      ]
    },
    {
      "descriptor_version": 1,
      "kind": "model",
      "slug": "lst-detector",
      "name": "Land Surface Temperature Detector",
      "description": "Derives land surface temperature (LST) from Landsat thermal infrared imagery (Band 10 / LWIR11). Reports mean surface temperature and the fraction of pixels exceeding a configurable heat threshold.",
      "requires": {
        "bands": [
          "thermal1"
        ],
        "max_cloud_cover": 20.0,
        "gsd_m": null,
        "cost": "medium"
      },
      "prefilter": null,
      "scores": {
        "lst_mean": {
          "description": "Mean land surface temperature across valid pixels",
          "unit": "\u00b0C",
          "range": [
            -20.0,
            70.0
          ],
          "primary": true,
          "thresholds": {
            "green": [
              -20.0,
              30.0
            ],
            "yellow": [
              30.0,
              40.0
            ]
          }
        },
        "hot_fraction": {
          "description": "Fraction of valid pixels above 35.0\u00b0C",
          "unit": "fraction",
          "range": [
            0.0,
            1.0
          ],
          "primary": false,
          "thresholds": {
            "green": [
              0.0,
              0.1
            ],
            "yellow": [
              0.1,
              0.3
            ]
          }
        }
      },
      "rasters": [
        "lst"
      ]
    },
    {
      "descriptor_version": 1,
      "kind": "model",
      "slug": "ship-counter",
      "name": "Ship Counter",
      "description": "Counts ships and other vessels on open water, from true colour imagery.",
      "requires": {
        "bands": [
          "red",
          "green",
          "blue"
        ],
        "max_cloud_cover": 20.0,
        "gsd_m": null,
        "cost": "medium"
      },
      "prefilter": null,
      "scores": {
        "ship_count": {
          "description": "Number of vessels detected",
          "unit": "count",
          "range": [
            0,
            10000
          ],
          "primary": true,
          "thresholds": null
        }
      },
      "rasters": []
    }
  ],
